है कि attention और देना चाहिए तो मत दो",-0.07,0.07]],"segs":[[9600.4,9605.6,"agar main abhi mera gussa hee, like, that is the only way that I thought that I would get some attention, to be honest, yeah?",-0.09,0.01],[9605.8,9610.1,"matlab main attention seeking kar raha hoon, agar tumko lagta hai ki attention seeking hai, to haan, hai attention seeking.",-0.09,0.01],[9611.3,9617.1,"kyonki main ye sab cheejon ke baare men I care enough to grab your attention towards,",-0.09,0.01],[9617.1,9620.3,"aur uske baad agar tumko naheen lagta hai ki atenshan aur dena chaahie",-0.08,0.03],[9620.3,9621.6,"to mat do",-0.08,0.03]]},{"s":9626.2,"e":9629.1,"lang":"hi","p":{"en":0.001,"hi":0.998,"bn":0.0},"said":"hi","native":[[9626.2,9628.7,"किसने बोला है? मैं तोड़ी बोल रहा हूँ.",-0.11,0.03]],"segs":[[9626.2,9628.8,"kisne bole? main tori bol raha hoon.",-0.09,0.03]]}]},"9645.6":{"a":9645.6,"b":9667.3,"signs":["sweep"],"chunks":[{"s":9645.6,"e":9667.3,"lang":"en","p":{"en":0.995,"hi":0.003,"bn":0.0},"said":"en","skipped":true,"segs":[]}]},"9680.9":{"a":9680.9,"b":9759.5,"signs":["sweep"],"chunks":[{"s":9680.9,"e":9707.1,"lang":"en","p":{"en":0.989,"hi":0.009,"bn":0.0},"said":"en","skipped":true,"segs":[]},{"s":9707.1,"e":9733.7,"lang":"en","p":{"en":0.945,"hi":0.047,"bn":0.0},"said":"en","skipped":true,"segs":[]},{"s":9733.7,"e":9759.5,"lang":"en","p":{"en":0.897,"hi":0.078,"bn":0.0},"said":"en","skipped":true,"segs":[]}]},"9805.5":{"a":9805.5,"b":9879.9,"signs":["sweep"],"chunks":[{"s":9805.5,"e":9831.0,"lang":"en","p":{"en":0.896,"hi":0.089,"bn":0.0},"said":"en","skipped":true,"segs":[]},{"s":9831.0,"e":9858.0,"lang":"en","p":{"en":0.703,"hi":0.282,"bn":0.0},"said":"en","skipped":true,"segs":[]},{"s":9858.0,"e":9879.9,"lang":"en","p":{"en":0.975,"hi":0.022,"bn":0.0},"said":"en","skipped":true,"segs":[]}]}}}